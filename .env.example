# ════════════════════════════════════════════════════════════════════════════
# CATENA / VAIDYAM — environment for Next.js (Vercel) + Postgres (Supabase)
# ════════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env
#
# Required for persistence + /api/health DB check:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional — Supabase REST (free tier). When absent, API uses Postgres via Drizzle only.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# Optional — external data / LLM keys (each panel degrades gracefully without them)
# USDA_API_KEY=
# GROQ_API_KEY=
# NVIDIA_NIM_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
