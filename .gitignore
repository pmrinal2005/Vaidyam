# prod
dist/

# dev
.yarn/
!.yarn/releases
.vscode/*
!.vscode/launch.json
!.vscode/*.code-snippets
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf

# deps
node_modules/
.wrangler

# env — real secrets. The *.example templates ARE tracked (see README).
.env
.env.*
!.env.example
.env.production
.dev.vars
.dev.vars.*
!.dev.vars.example

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# misc
.DS_Store

# Build output (all generated — never commit)
dist/
dist-static/
.wrangler/
.vercel/
.reveal-build/
.local-engine-build/

# Generated reveal island bundle. Produced by `npm run build:reveal` from
# src/reveal/*. Committing it caused a *stale bundle* bug: the compiled JS kept
# serving a removed Mux HLS <video> long after App.tsx had dropped it, because
# nothing forced a rebuild. Always generated, never tracked.
public/static/reveal/

# Generated in-browser API engine. Produced by `npm run build:engine` from
# src/local/engine.ts (which imports src/api/index.ts). Same stale-bundle
# hazard as above: it must always be rebuilt from the current API source, or the
# browser fallback silently drifts from the edge worker it is meant to mirror.
public/static/dash/local-engine.js

# Editor duplicate artifacts (e.g. "core - Copy.js") — these shadowed real
# sources during review and must never be committed.
* - Copy.*
*\ -\ Copy.*
*[- ]Copy.*

# Superseded by this file; kept out of the tree so there is exactly one
# authoritative ignore list.
gitignore.txt

# Release archives produced for download.
*.zip
*.tar.gz
