{
  "name": "webapp",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:reveal && vite build",
    "build:reveal": "node scripts/build-reveal.mjs",
    "build:static": "npm run build:reveal && node scripts/build-static.mjs",
    "preview": "wrangler pages dev dist",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "serve:static": "node scripts/serve-static.mjs",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -sSf http://localhost:3000 > /dev/null && echo OK",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.33",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
